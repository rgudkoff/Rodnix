# Rodnix POSIX syscall master table
#
# Format:  <number> <name>
# Status annotations (comments only — not parsed by mkposixsyscalls.py):
#   [stable]       — ABI frozen, handler fully implemented, covered by tests
#   [experimental] — implemented but ABI or semantics may change
#   [stub]         — registered, returns RDNX_E_UNSUPPORTED or minimal impl
#
# Numbers 0-68 are the POSIX namespace.  Numbers 120+ are kernel-internal
# (SYS_* in syscall.h).  A _Static_assert in syscall.c enforces no overlap.
# Do NOT renumber existing entries — userland binaries depend on these values.
#
# Generated artifacts (do not edit by hand):
#   kernel/posix/posix_sysnums.h
#   userland/include/posix_sysnums.h
#   kernel/posix/posix_sysent.inc

0  nosys           # [stable]       no-op / unsupported
1  getpid          # [stable]
2  getuid          # [stable]
3  geteuid         # [stable]
4  getgid          # [stable]
5  getegid         # [stable]
6  setuid          # [stable]
7  seteuid         # [stable]
8  setgid          # [stable]
9  setegid         # [stable]
10 open            # [stable]
11 close           # [stable]
12 read            # [stable]
13 write           # [stable]
14 uname           # [stable]
15 exit            # [stable]
16 exec            # [stable]
17 spawn           # [experimental] rodnix-specific; use fork+exec in new code
18 waitpid         # [stable]
19 readdir         # [stable]
20 fcntl           # [experimental] only F_GETFD/F_SETFD implemented
21 netiflist       # [experimental]
22 mmap            # [stable]
23 munmap          # [stable]
24 brk             # [stable]
25 fork            # [stable]
26 hwlist          # [stub]
27 fabricls        # [experimental]
28 fabricevents    # [stub]
29 sysinfo         # [experimental]
30 clock_gettime   # [stable]
31 stat            # [stable]
32 fstat           # [stable]
33 lseek           # [stable]
34 scstat          # [experimental]
35 pipe            # [stable]
36 dup             # [stable]
37 dup2            # [stable]
38 chdir           # [stable]
39 getcwd          # [stable]
40 mkdir           # [stable]
41 unlink          # [stable]
42 rmdir           # [stable]
43 rename          # [stable]
44 ioctl           # [experimental] only ISATTY/GETATTR/SETATTR on TTY
45 nanosleep       # [stable]
46 kill            # [stable]
47 sigaction       # [stable]
48 sigreturn       # [stable]
49 blocklist       # [experimental]
50 blockread       # [experimental]
51 kmodls          # [experimental]
52 kmodload        # [stub]
53 kmodunload      # [stub]
54 blockwrite      # [experimental]
55 truncate        # [experimental]
56 ftruncate       # [experimental]
57 poll            # [stable]
58 select          # [stable]
59 dup3            # [stable]
60 pipe2           # [stable]
61 futex           # [experimental]
62 msync           # [stub]
63 socket          # [experimental]
64 bind            # [experimental]
65 connect         # [experimental]
66 sendto          # [experimental]
67 recvfrom        # [experimental]
68 ping            # [stub]
69 openat          # [experimental] AT_FDCWD supported; mode arg ignored
70 listen          # [experimental] TCP server listen
71 accept          # [experimental] TCP server accept with timeout_ms in a3
72 chmod           # [stable]       path-based permission bits
77 lstat           # [stub]         like stat; no symlinks yet so identical
73 fchmod          # [stable]       fd-based permission bits
74 chown           # [stable]       path-based uid/gid; -1 = leave unchanged
75 fchown          # [stable]       fd-based uid/gid; -1 = leave unchanged
76 lchown          # [stub]         same as chown (no symlinks yet)
78 clone           # [experimental] create thread; CLONE_VM|CLONE_THREAD|CLONE_SETTLS|CLONE_CHILD_CLEARTID|CLONE_CHILD_SETTID
79 mprotect        # [stable]       change memory protection flags on mapped region
80 thread_exit     # [stable]       exit current thread only (not whole process)
81 getgroups       # [stable]       read supplementary groups of current task
82 setgroups       # [stable]       set supplementary groups; root only
83 settimeofday    # [experimental] set CLOCK_REALTIME; root only
84 rtc_gettime     # [experimental] read hardware RTC time
85 rtc_settime     # [experimental] write hardware RTC time; root only
86 mlock           # [experimental] wire a range: fault it in now, reclaim never takes it
87 munlock         # [experimental] unwire a range
88 schedrt         # [experimental] rodnix: a1=1 make current thread realtime, a1=0 back to timeshare
89 threadfaults    # [experimental] rodnix: page faults taken by current thread
90 memband         # [experimental] rodnix: a1=band set current task's OOM band; a1=-1 read it
91 mempressure     # [experimental] rodnix: memory pressure level 0/1/2
