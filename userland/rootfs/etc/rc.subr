#!/bin/sh

if [ -z "$name" ]; then
    echo "rc.subr: name is not set" >&2
    exit 1
fi

run_rc_command() {
    action="$1"

    if [ -z "$action" ]; then
        echo "usage: ${name} {start|stop|restart|status}" >&2
        return 1
    fi

    case "$action" in
    start|stop|restart|status)
        exec /bin/svctl "$action" "$name"
        ;;
    *)
        echo "${name}: unsupported action '$action'" >&2
        return 1
        ;;
    esac
}
